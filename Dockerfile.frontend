# Multi-stage build
# Stage 1: Build the Next.js application
FROM --platform=$BUILDPLATFORM node:24-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY tgdcfs-gh-pages/package*.json ./

# Install dependencies (including devDependencies for build)
RUN npm ci

# Copy source code
COPY tgdcfs-gh-pages/ .

# The repository and Docker Hub namespace the image is built for. The config
# generator and the guides show the Docker images of that repository; the
# publishing workflows pass both, a plain local build falls back to the
# upstream's coordinates (see tgdcfs-gh-pages/next.config.ts).
ARG GITHUB_REPOSITORY
ARG DOCKERHUB_NAMESPACE

# Build the application
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy the built static files from the builder stage
COPY --from=builder /app/out /usr/share/nginx/html/tgdcfs

# Copy nginx configuration
COPY tgdcfs-fe-nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
